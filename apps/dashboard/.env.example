# Copy to .env for local development.
#
# NODE_ENV is deliberately NOT set here. `next dev` sets it to "development",
# `next build` / `next start` to "production", `bun run <script>` defaults to
# "development" and `bun test` to "test" — all values `@workspace/env` accepts.
# Pinning NODE_ENV=development in .env makes `next build` prerender Next's
# internal /_global-error page against a development React and fail with
# "TypeError: null is not an object (evaluating '…useContext')".

DATABASE_URL=postgres://postgres:password@localhost:5432/next-template
BETTER_AUTH_SECRET=dev-secret-not-for-production
BETTER_AUTH_URL=http://localhost:3001
PROJECT_NAME=recepcionai
